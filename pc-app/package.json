    "chokidar": "^5.0.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.screenshotgraveyard.app",
