  "version": "1.0.0",
  "description": "Screenshot Graveyard Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": {
    "name": "Developer",
    "email": "dev@example.com"
  },
  "homepage": "https://github.com/example/screenshot-graveyard",
